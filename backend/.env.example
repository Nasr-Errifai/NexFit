# NexFit API — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

APP_NAME=NexFit API
APP_VERSION=0.1.0
DEBUG=false

# Connexion Postgres Supabase (pooler IPv4 — voir supabase/.temp/pooler-url)
# Username = postgres.<project-ref>, host = aws-<N>-<region>.pooler.supabase.com
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://ordxvysxzyqwyxqmxwjg.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=ordxvysxzyqwyxqmxwjg

# CORS
CORS_ORIGINS=["http://localhost:5173"]
